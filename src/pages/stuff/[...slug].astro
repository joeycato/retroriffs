---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('blog')) as CollectionEntry<'blog'>[]
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

type Props = {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props as Props
const { Content } = await render(post)
const canonicalURL = new URL(`/stuff/${post.id}/`, Astro.site)
const pageDescription = `${post.data.title}: ${post.data.excerpt || 'A creative technology project'}. An interactive project by Joey Cato.`
const socialImage = post.data.img || '/site-icon.png'
const socialImageURL = new URL(
  typeof socialImage === 'string' ? socialImage : socialImage.src,
  Astro.site
)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: pageDescription,
  image: socialImageURL.href,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updatedDate && {
    dateModified: post.data.updatedDate.toISOString(),
  }),
  author: {
    '@type': 'Person',
    name: 'Joey Cato',
    url: new URL('/', Astro.site).href,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href,
  },
  keywords: post.data.tags.join(', '),
  inLanguage: 'en-US',
}

function kebabCase(str: string): string {
  return str
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')
}
---

<BaseLayout
  title={post.data.seoTitle || post.data.title}
  description={pageDescription}
  image={socialImage}
  imageAlt={`${post.data.title} project preview`}
  type="article"
  publishedTime={post.data.date}
  updatedTime={post.data.updatedDate}
  tags={post.data.tags}
  structuredData={structuredData}
>
  <main id="main-content" class="clearfix post-content-box">
    <article class="article-page">
      <div class="page-content">
        <div class="wrap-content">
          <header class="header-page">
            <h1 class="page-title">{post.data.title}</h1>
          </header>
          <div class="post-body">
            <Content />
          </div>
          <div class="page-footer">
            <div class="page-tag">
              {
                post.data.tags &&
                  post.data.tags.map((tag: string) => (
                    <span>
                      <a class="tag" href={`/tags/${kebabCase(tag)}/`}>
                        # {tag}
                      </a>
                    </span>
                  ))
              }
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

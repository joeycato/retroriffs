---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'

const posts = (await getCollection('blog')) as CollectionEntry<'blog'>[]

// Hack Day projects are collected on a dedicated overview page.
const hackDayPosts = posts.filter((post) => post.data.tags.includes('hackday'))
const retroTvIds = new Set([
  'my50stv',
  'my60stv',
  'my70stv',
  'my80stv',
  'my90stv',
  'my2000stv',
])
const retroTvPosts = posts.filter((post) => retroTvIds.has(post.id))
const sortedPosts = posts
  .filter(
    (post) => !post.data.tags.includes('hackday') && !retroTvIds.has(post.id)
  )
  .sort((a, b) => b.data.priority - a.data.priority || a.id.localeCompare(b.id))
const hackDayCover = hackDayPosts.find(
  (post) => post.id === 'hackday-videoviews'
)?.data.img
const retroTvCover = retroTvPosts.find((post) => post.id === 'my80stv')?.data
  .img

const siteUrl = Astro.site?.toString() || 'https://joeycato.com/'
const homeDescription =
  'Interactive web experiments, nostalgic projects, games, data visualizations, and creative technology by Joey Cato.'
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Joey Cato',
      url: siteUrl,
      image: new URL('/site-icon.png', siteUrl).href,
      sameAs: [
        'https://bsky.app/profile/joeycato.bsky.social',
        'https://www.linkedin.com/in/joeycato',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Joey Cato',
      alternateName: "joey's stuff",
      url: siteUrl,
      description: homeDescription,
      author: { '@id': `${siteUrl}#person` },
      inLanguage: 'en-US',
    },
  ],
}
---

<BaseLayout description={homeDescription} structuredData={structuredData}>
  <main id="main-content" class="content-box clearfix">
    <header class="home-intro">
      <h1>Stuff I've made</h1>
      <p>{homeDescription}</p>
    </header>
    <article class="post collection-post">
      {
        hackDayCover && (
          <a href="/stuff/netflix-hack-days/" class="post-thumbnail">
            <Image
              src={hackDayCover}
              alt="Netflix Hack Days project collection preview"
              class="page-image"
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 30vw"
            />
          </a>
        )
      }
      <div class="post-content">
        <h2 class="post-title">
          <a href="/stuff/netflix-hack-days/">Netflix Hack Days</a>
        </h2>
        <p>Submissions I created for Netflix Hack Day over the years</p>
      </div>
    </article>
    <article class="post collection-post">
      {
        retroTvCover && (
          <a href="/stuff/my-retro-tvs/" class="post-thumbnail">
            <Image
              src={retroTvCover}
              alt="My Retro TVs collection preview"
              class="page-image"
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 30vw"
            />
          </a>
        )
      }
      <div class="post-content">
        <h2 class="post-title">
          <a href="/stuff/my-retro-tvs/">My Retro TVs</a>
        </h2>
        <p>Channel-surf through six decades of television history</p>
      </div>
    </article>
    {
      sortedPosts.map((post) => (
        <article class="post">
          {post.data.img && (
            <a href={`/stuff/${post.id}/`} class="post-thumbnail">
              <Image
                src={post.data.img}
                alt={`${post.data.title} project preview`}
                class="page-image"
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 30vw"
              />
            </a>
          )}
          <div class="post-content">
            <h2 class="post-title">
              <a href={`/stuff/${post.id}/`}>{post.data.title}</a>
            </h2>
            {post.data.excerpt && <p>{post.data.excerpt}</p>}
          </div>
        </article>
      ))
    }
  </main>
</BaseLayout>

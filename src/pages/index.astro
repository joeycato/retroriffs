---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import retroTvCover from '../assets/share-logo-square-v3.png'
import BaseLayout from '../layouts/BaseLayout.astro'

const posts = (await getCollection('blog')) as CollectionEntry<'blog'>[]

// Hack Day projects are collected on a dedicated overview page.
const hackDayPosts = posts.filter((post) => post.data.tags.includes('hackday'))
const retroTvIds = new Set([
  'my50stv',
  'my60stv',
  'my70stv',
  'my80stv',
  'my90stv',
  'my2000stv',
])
const retroTvPosts = posts.filter((post) => retroTvIds.has(post.id))
const gameIds = new Set([
  'gorchsquest',
  'prs2000',
  'space-cavern',
  'space-hex',
  'pacpeeps',
  'bloops',
])
const gamePosts = posts.filter((post) => gameIds.has(post.id))
const videoExperimentIds = new Set(['boundless-video', 'woymfx', 'rickrollfx'])
const videoExperimentPosts = posts.filter((post) =>
  videoExperimentIds.has(post.id)
)
const nostalgicDeepDiveIds = new Set([
  'paris-texas-1914',
  'deep-nostalgia-with-movie-posters',
  'rediscovering-history-with-photoshop',
  'circle-of-life',
  'bandersnatch-demo',
  'road-trips-reenacted',
  'paris-in-1981',
])
const nostalgicDeepDivePosts = posts.filter((post) =>
  nostalgicDeepDiveIds.has(post.id)
)
const otherAppIds = new Set([
  'fave-save',
  'faceportal-app',
  'song-branch',
  'rxify',
])
const otherAppPosts = posts.filter((post) => otherAppIds.has(post.id))
const hackDayCover = hackDayPosts.find(
  (post) => post.id === 'hackday-videoviews'
)?.data.img
const gamesCover = gamePosts.find((post) => post.id === 'bloops')?.data.img
const videoExperimentsCover = videoExperimentPosts.find(
  (post) => post.id === 'boundless-video'
)?.data.img
const nostalgicDeepDivesCover = nostalgicDeepDivePosts.find(
  (post) => post.id === 'paris-texas-1914'
)?.data.img
const otherAppsCover = otherAppPosts.find((post) => post.id === 'fave-save')
  ?.data.img

function highestPriority(collectionPosts: CollectionEntry<'blog'>[]): number {
  return Math.max(...collectionPosts.map((post) => post.data.priority), 0)
}

const collectionItems = [
  {
    id: 'netflix-hack-days',
    title: 'Netflix Hack Days',
    excerpt: 'Submissions I created for Netflix Hack Day over the years',
    href: '/stuff/netflix-hack-days/',
    img: hackDayCover,
    priority: highestPriority(hackDayPosts),
  },
  {
    id: 'my-retro-tvs',
    title: 'My Retro TVs',
    excerpt: 'Channel-surf through six decades of television history',
    href: '/stuff/my-retro-tvs/',
    img: retroTvCover,
    priority: highestPriority(retroTvPosts),
  },
  {
    id: 'games',
    title: 'Games',
    excerpt: "Games and playful experiments I've created over the years",
    href: '/stuff/games/',
    img: gamesCover,
    priority: highestPriority(gamePosts),
  },
  {
    id: 'video-experiments',
    title: 'Video Experiments',
    excerpt: 'Interactive effects that transform music videos in real time',
    href: '/stuff/video-experiments/',
    img: videoExperimentsCover,
    priority: highestPriority(videoExperimentPosts),
  },
  {
    id: 'nostalgic-deep-dives',
    title: 'Nostalgic Deep Dives',
    excerpt:
      'Experiments that revisit personal, local, and pop-culture history',
    href: '/stuff/nostalgic-deep-dives/',
    img: nostalgicDeepDivesCover,
    priority: highestPriority(nostalgicDeepDivePosts),
  },
  {
    id: 'other-apps',
    title: 'Other Apps',
    excerpt: 'Utilities, visualizations, and creative apps I have built',
    href: '/stuff/other-apps/',
    img: otherAppsCover,
    priority: highestPriority(otherAppPosts),
  },
].map((item) => ({ ...item, isCollection: true }))

const standaloneItems = posts
  .filter(
    (post) =>
      !post.data.tags.includes('hackday') &&
      !retroTvIds.has(post.id) &&
      !gameIds.has(post.id) &&
      !videoExperimentIds.has(post.id) &&
      !nostalgicDeepDiveIds.has(post.id) &&
      !otherAppIds.has(post.id)
  )
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    excerpt: post.data.excerpt,
    href: `/stuff/${post.id}/`,
    img: post.data.img,
    priority: post.data.priority,
    isCollection: false,
  }))

const homeItems = [...collectionItems, ...standaloneItems].sort(
  (a, b) => b.priority - a.priority || a.id.localeCompare(b.id)
)

const siteUrl = Astro.site?.toString() || 'https://joeycato.com/'
const homeDescription =
  'Interactive web experiments, nostalgic projects, games, data visualizations, and creative technology by Joey Cato.'
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Joey Cato',
      url: siteUrl,
      image: new URL('/site-icon.png', siteUrl).href,
      sameAs: [
        'https://bsky.app/profile/joeycato.bsky.social',
        'https://www.linkedin.com/in/joeycato',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'Joey Cato',
      alternateName: "joey's stuff",
      url: siteUrl,
      description: homeDescription,
      author: { '@id': `${siteUrl}#person` },
      inLanguage: 'en-US',
    },
  ],
}
---

<BaseLayout description={homeDescription} structuredData={structuredData}>
  <main id="main-content" class="content-box clearfix">
    <header class="home-intro">
      <h1>Stuff I've made</h1>
      <p>{homeDescription}</p>
    </header>
    {
      homeItems.map((item) => (
        <article class:list={['post', item.isCollection && 'collection-post']}>
          {item.img && (
            <a href={item.href} class="post-thumbnail">
              <Image
                src={item.img}
                alt={`${item.title} ${item.isCollection ? 'collection' : 'project'} preview`}
                class="page-image"
                widths={[400, 800]}
                sizes="(max-width: 768px) 100vw, 30vw"
              />
            </a>
          )}
          <div class="post-content">
            <h2 class="post-title">
              <a href={item.href}>{item.title}</a>
            </h2>
            {item.excerpt && <p>{item.excerpt}</p>}
          </div>
        </article>
      ))
    }
  </main>
</BaseLayout>
